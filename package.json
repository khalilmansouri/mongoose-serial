{
  "name": "mongoose-serial",
  "version": "2.1.0",
  "description": "Mongoose plugin for generating auto-incrementing serial numbers with flexible formatting options",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "nyc mocha -r ts-node/register src/**/*.test.ts",
    "test:unit": "mocha -r ts-node/register src/test/unit.test.ts src/test/integration.test.ts",
    "test:integration": "mocha -r ts-node/register src/test/basic.test.ts src/test/withoutDate.test.ts src/test/withoutPrefix.test.ts src/test/withoutPrefixAndDate.test.ts",
    "posttest": "nyc report --reporter=json",
    "build": "tsc",
    "clean": "rm -rf lib",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "dev": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalilmansouri/mongoose-serial.git"
  },
  "keywords": [
    "mongoose",
    "serial",
    "serial-number",
    "auto-increment",
    "plugin",
    "typescript",
    "mongodb"
  ],
  "author": "Khalil Mansouri",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/khalilmansouri/mongoose-serial/issues"
  },
  "homepage": "https://github.com/khalilmansouri/mongoose-serial#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chai": "^4.3.15",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.9",
    "async": "^3.2.5",
    "chai": "^4.4.1",
    "codecov": "^3.8.3",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "mocha": "^10.4.0",
    "mongoose": "^8.0.3",
    "nyc": "^15.1.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "lib",
    "README.md",
    "LICENCE"
  ]
}
